---
import Base from '../layouts/Base.astro';
import { SITE } from '../config.js';

const mods = import.meta.glob('../data/articles/*.js', { eager: true });
const live = Object.values(mods).map((m) => m.default).filter((a) => !a.draft);

export async function getStaticPaths() {
  const mods = import.meta.glob('../data/articles/*.js', { eager: true });
  return Object.values(mods)
    .filter((m) => !m.default.draft)   // draft: true keeps a page off the site
    .map((m) => ({ params: { slug: m.default.slug }, props: { a: m.default } }));
}

const { a } = Astro.props;

// Other stories, newest first, for the "more" block at the end.
const more = live
  .filter((x) => x.slug !== a.slug)
  .sort((x, y) => new Date(y.date) - new Date(x.date))
  .slice(0, 3);
---
<Base title={`${a.title} | ${SITE.name}`} description={a.description} image={a.hero?.src}>
  <article>
    <p class="kicker">{a.kicker}</p>
    <h1>{a.title}</h1>
    <p class="dek">{a.dek}</p>

    <p class="byline">
      By <strong>{a.author}</strong> · {a.dateLabel} · {a.readingTime}
    </p>
    {a.partner && <p class="tag">{SITE.partnerTag}</p>}

    {a.hero && (
      <>
        <img class="hero" src={a.hero.src} alt={a.hero.alt} loading="eager" fetchpriority="high" />
        <p class="caption">{a.hero.caption}</p>
      </>
    )}

    <div class="body" class:list={{ 'body--flush': !a.hero && !a.partner }}>
      {a.blocks.map((b) => {
        if (b.type === 'p') return <p set:html={b.html} />;
        if (b.type === 'pull') return <blockquote class="pull" set:html={b.html} />;

        if (b.type === 'trend')
          return (
            <section class="tr">
              <div class="tr__top">
                <div class="tr__figwrap">
                  {b.img ? (
                    <img class="tr__img" src={b.img} alt={b.alt} loading="lazy" />
                  ) : (
                    <div class="tr__ph"><span>{b.imgNote}</span></div>
                  )}
                </div>
                <div class="tr__meta">
                  <span class="tr__num">{b.num}</span>
                  <h2>{b.h2}</h2>
                  {b.cta ? (
                    <a class="tr__cta" href={b.href} rel="sponsored noopener">{b.cta}</a>
                  ) : b.tag ? (
                    // Not a link and not focusable — it keeps the column rhythm
                    // without inviting a click that goes nowhere.
                    <span class="tr__tag" aria-hidden="true">{b.tag}</span>
                  ) : null}
                  {b.credit && <span class="tr__credit">Credit: {b.credit}</span>}
                </div>
              </div>
              <p class="tr__text" set:html={b.text} />
            </section>
          );

        if (b.type === 'entry')
          return (
            <div class="entry">
              <p class="entry__num">{b.num}</p>
              <h2>{b.h2}</h2>
            </div>
          );

        if (b.type === 'pick')
          return (
            <aside class="pick">
              <p class="pick__label">{b.label}</p>
              <img class="pick__img" src={b.img} alt={b.alt} loading="lazy" />
              <p class="pick__name">{b.name}</p>
              {b.price && <p class="pick__price">{b.price}</p>}
              <p>{b.blurb}</p>
              <a class="cta" href={b.href} rel="sponsored noopener">{b.ctaText}</a>
            </aside>
          );

        if (b.type === 'grid')
          return (
            <div class="grid">
              {b.items.map((i) => (
                <a class="card" href={i.href} rel="sponsored noopener">
                  <img src={i.img} alt={i.alt} loading="lazy" />
                  <span class="card__name">{i.name}</span><br />
                  <span class="card__price">{i.price}</span>
                </a>
              ))}
            </div>
          );

        if (b.type === 'note')
          return <p class="note" set:html={b.html} />;

        if (b.type === 'cta')
          return (
            <aside class="endcta">
              <p>{b.text}</p>
              <a class="cta" href={b.href} rel="sponsored noopener">{b.ctaText}</a>
            </aside>
          );

        return null;
      })}
    </div>
  </article>

  {more.length > 0 && (
    <section class="more">
      <p class="more__label">More from {SITE.name}</p>
      {more.map((m) => (
        <a class="more__item" href={`/${m.slug}/`}>
          <span class="more__kicker">{m.kicker}</span>
          <span class="more__title">{m.title}</span>
          <span class="more__meta">{m.dateLabel} · {m.readingTime}</span>
        </a>
      ))}
    </section>
  )}
</Base>
